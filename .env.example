VITE_ENABLE_SCANNER=true
# Verbose auth/session debug logging. Leave 0 (or unset). NEVER set to 1 in
# production — it compiles the debug blocks (fetch interceptor, auth-event
# logging, window debug helpers) back into the bundle.
VITE_DEBUG_LOG=0

# Error monitoring (optional). Set to a GlitchTip/Sentry project DSN to enable
# error reporting; leave unset to disable. Vite inlines this at BUILD time, so
# set it in Vercel BEFORE building, then redeploy.
# VITE_SENTRY_DSN=https://<key>@<your-glitchtip-domain>/<project-id>

# Staging
VITE_API_URL=https://<your-railway-backend-url>.up.railway.app
VITE_SUPABASE_URL=https://<your-supabase-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Production
# VITE_API_URL=https://api.clauseatlas.com
# VITE_SUPABASE_URL=https://<your-supabase-project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# NOTE: Never commit real keys here. Set actual values in:
#   - Vercel dashboard (Environment Variables) for production
#   - Local .env file (gitignored) for development
