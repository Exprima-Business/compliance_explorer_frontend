# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables — secrets audit 2026-06 v2 hardening.
# `.env.*` catches .env.production, .env.staging, etc. that the prior
# narrow patterns didn't cover.
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# Claude Code worktrees — never commit local agent workspace.
# One discovered .claude/worktrees/*/.env.txt was carrying a (retired)
# real JWT during the audit; .claude/ being unignored = one git-add
# away from a real commit-time leak.
.claude/

# Build output
dist/
build/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Logs
logs/
*.log

# Upload directory
uploads/

# TypeScript
*.tsbuildinfo

# Compiled JS and declaration files in src/ (tsc output)
src/**/*.js
src/**/*.d.ts
!src/vite-env.d.ts
